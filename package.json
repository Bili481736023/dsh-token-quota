{
  "name": "@local/dsh-token-quota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "在左侧栏底部悬浮显示 DeepSeek 账户余额（CNY）、可用 tokens 与高峰/空闲时段每百万 tokens 价格。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
